# Optional local overrides. Copy to .env; do not commit .env.
# Project storage defaults to <this repo>/.mnemosyne when these are unset.
# MNEMOSYNE_HOME=/absolute/path/to/.mnemosyne
# MNEMOSYNE_DATA_DIR=/absolute/path/to/.mnemosyne/data

MNEMOSYNE_MCP_BANK=default
MNEMOSYNE_DEFAULT_SCOPE=global
MNEMOSYNE_EMBEDDING_API_URL=http://localhost:11434/v1
MNEMOSYNE_EMBEDDING_MODEL=nomic-embed-text
MNEMOSYNE_EMBEDDING_DIM=768
MNEMOSYNE_LLM_ENABLED=false
MNEMOSYNE_JOURNAL_MODE=wal
MNEMOSYNE_PACKAGE=mnemosyne-memory[mcp]==3.15.1

# Do not configure an embedding API key for local HTTP Ollama.
# The wrapper also unsets inherited cloud embedding keys.
